    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "docs:check": "node scripts/check-docs.mjs",
    "unused": "knip",
    "release-notes": "node scripts/release-notes.mjs",
