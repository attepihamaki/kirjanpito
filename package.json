    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "papaparse": "^5.7.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
