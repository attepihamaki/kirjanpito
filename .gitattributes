# Store text as LF in the repository and check it out as LF everywhere.
# This matches Prettier's `endOfLine: "lf"`. Without it, a Windows clone gets
# CRLF working-tree files and every file reads as unformatted.
* text=auto eol=lf

# Windows-only scripts must keep CRLF to run.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Never touch these.
*.xlsx binary
*.xls binary
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.heic binary
*.woff binary
*.woff2 binary
*.zip binary
